{
  "name": "chg-website",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check && tsc --project tsconfig.json --noEmit && eslint .",
    "clean": "rm -rf ./.astro && rm -rf ./dist && rm -rf ./node_modules && rm -rf pnpm-lock.yaml && rm -rf *.lock ; rm -rf *.log",
    "dev": "astro dev",
    "fmt:check": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "astro preview",
    "start": "astro dev",
    "update": "pnpm install --latest",
    "upgrade": "pnpm dlx @astrojs/upgrade"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/starlight": "^0.38.2",
    "@astrojs/svelte": "^8.0.3",
    "@catppuccin/starlight": "^2.0.1",
    "astro": "^6.0.8",
    "svelte": "^5.53.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "astro-eslint-parser": "^1.3.0",
    "eslint": "^10.1.0",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-svelte": "^3.16.0",
    "oxfmt": "^0.41.0",
    "svelte-eslint-parser": "^1.6.0",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
